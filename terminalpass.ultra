<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>terminalpass.ultra</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');

*{margin:0;padding:0;box-sizing:border-box}

:root{--0:#000;--1:#fff;--2:#111;--3:#222;--4:#555;--5:#888;--6:#ccc;--7:#eee;--8:#f5f5f5}

.loader{position:fixed;inset:0;background:var(--0);display:flex;align-items:center;justify-content:center;z-index:200;transition:opacity .6s ease,visibility .6s ease}
.loader.hide{opacity:0;visibility:hidden}
.loader-bar{width:120px;height:1px;background:var(--3);position:relative;overflow:hidden}
.loader-bar::after{content:'';position:absolute;left:0;top:0;height:100%;width:0;background:var(--1);animation:load 1.4s cubic-bezier(.4,0,.2,1) forwards}
@keyframes load{0%{width:0}100%{width:100%}}

body{background:var(--0);color:var(--1);font-family:'Inter',sans-serif;min-height:100vh;display:flex;align-items:center;justify-content:center}

.app{width:400px;max-width:92vw;opacity:0;transform:translateY(8px);transition:opacity .8s ease .3s,transform .8s ease .3s}
.app.show{opacity:1;transform:translateY(0)}

.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:48px;padding-bottom:16px;border-bottom:1px solid var(--3)}
.top span{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--5)}
.top button{background:none;border:none;color:var(--5);cursor:pointer;font-size:11px;letter-spacing:1px;text-transform:uppercase;font-family:inherit;padding:4px 0;position:relative;transition:color .2s}
.top button::after{content:'';position:absolute;bottom:0;left:0;width:0;height:1px;background:var(--1);transition:width .3s ease}
.top button:hover{color:var(--1)}
.top button:hover::after{width:100%}

.pw-wrap{margin-bottom:8px;min-height:64px;display:flex;align-items:center;position:relative;cursor:pointer;padding:20px 0;border-bottom:1px solid var(--3);transition:border-color .3s}
.pw-wrap:hover{border-color:var(--4)}
.pw-wrap:active{border-color:var(--5)}

.pw{font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:500;letter-spacing:2px;word-break:break-all;line-height:1.3;user-select:all}
.pw .c{display:inline-block;opacity:0;animation:cin .25s ease forwards}
@keyframes cin{to{opacity:1}}

.pw-hint{position:absolute;right:0;top:50%;transform:translateY(-50%);font-size:10px;letter-spacing:1px;text-transform:uppercase;color:var(--4);opacity:0;transition:opacity .2s}
.pw-wrap:hover .pw-hint{opacity:1}
.pw-wrap.copied .pw-hint{color:var(--1);opacity:1}

.bar{height:1px;background:var(--3);margin-bottom:40px;position:relative}
.bar-fill{position:absolute;left:0;top:0;height:100%;background:var(--1);width:0;transition:width .5s cubic-bezier(.16,1,.3,1)}

.opts{display:flex;flex-direction:column;gap:28px;margin-bottom:40px}

.opt{display:flex;align-items:center;justify-content:space-between}
.opt-label{font-size:13px;color:var(--5);font-weight:400}
.opt-label em{font-style:normal;color:var(--6)}

.opt-right{display:flex;align-items:center;gap:16px}

.len-val{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--5);min-width:28px;text-align:right}

input[type=range]{-webkit-appearance:none;appearance:none;width:140px;height:1px;background:var(--3);outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:10px;height:10px;border-radius:50%;background:var(--1);cursor:pointer;transition:transform .15s}
input[type=range]::-webkit-slider-thumb:hover{transform:scale(1.4)}
input[type=range]::-moz-range-thumb{width:10px;height:10px;border-radius:50%;background:var(--1);border:none;cursor:pointer}

.sw{width:32px;height:16px;border-radius:16px;background:var(--3);position:relative;cursor:pointer;transition:background .2s;flex-shrink:0}
.sw::after{content:'';position:absolute;width:10px;height:10px;border-radius:50%;background:var(--5);top:3px;left:3px;transition:transform .2s cubic-bezier(.4,0,.2,1),background .2s}
.sw.on{background:var(--5)}
.sw.on::after{transform:translateX(16px);background:var(--1)}

.gen{width:100%;padding:14px;border:1px solid var(--3);border-radius:0;background:none;color:var(--5);font-family:inherit;font-size:12px;letter-spacing:2px;text-transform:uppercase;cursor:pointer;transition:all .25s;position:relative;overflow:hidden}
.gen:hover{color:var(--1);border-color:var(--4)}
.gen:active{background:var(--1);color:var(--0);border-color:var(--1)}

.history{margin-top:32px;padding-top:24px;border-top:1px solid var(--3)}
.history-title{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--4);margin-bottom:16px}
.history-list{display:flex;flex-direction:column;gap:1px}
.history-item{padding:10px 0;font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--4);cursor:pointer;transition:color .2s;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid transparent}
.history-item:hover{color:var(--1)}
.history-item span:last-child{font-family:'Inter',sans-serif;font-size:10px;letter-spacing:1px;text-transform:uppercase;opacity:0;transition:opacity .2s}
.history-item:hover span:last-child{opacity:1}

.toast{position:fixed;bottom:32px;left:50%;transform:translateX(-50%) translateY(20px);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--0);background:var(--1);padding:8px 20px;opacity:0;transition:all .3s ease;pointer-events:none;z-index:50}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media(max-width:480px){.app{width:100%;padding:0 20px}.pw{font-size:18px}input[type=range]{width:100px}}
</style>
</head>
<body>

<div class="loader" id="loader"><div class="loader-bar"></div></div>

<div class="app" id="app">
  <div class="top">
    <span>terminalpass.ultra</span>
    <button id="copyBtn">copy</button>
  </div>

  <div class="pw-wrap" id="pwWrap">
    <div class="pw" id="pw"></div>
    <div class="pw-hint">click</div>
  </div>

  <div class="bar"><div class="bar-fill" id="barFill"></div></div>

  <div class="opts">
    <div class="opt">
      <span class="opt-label">length</span>
      <div class="opt-right">
        <span class="len-val" id="lenVal">16</span>
        <input type="range" id="lenSlider" min="4" max="64" value="16">
      </div>
    </div>
    <div class="opt">
      <span class="opt-label">uppercase <em>A-Z</em></span>
      <div class="sw on" data-k="upper"></div>
    </div>
    <div class="opt">
      <span class="opt-label">lowercase <em>a-z</em></span>
      <div class="sw on" data-k="lower"></div>
    </div>
    <div class="opt">
      <span class="opt-label">numbers <em>0-9</em></span>
      <div class="sw on" data-k="nums"></div>
    </div>
    <div class="opt">
      <span class="opt-label">symbols <em>!@#$</em></span>
      <div class="sw on" data-k="syms"></div>
    </div>
  </div>

  <button class="gen" id="genBtn">generate</button>

  <div class="history" id="histSec" style="display:none">
    <div class="history-title">history</div>
    <div class="history-list" id="histList"></div>
  </div>
</div>

<div class="toast" id="toast">copied</div>

<script>
const $=id=>document.getElementById(id)

const S={len:16,upper:true,lower:true,nums:true,syms:true,cur:'',hist:[]}
const C={upper:'ABCDEFGHIJKLMNOPQRSTUVWXYZ',lower:'abcdefghijklmnopqrstuvwxyz',nums:'0123456789',syms:'!@#$%^&*()_+-=[]{}|;:,.<>?'}

setTimeout(()=>{$('loader').classList.add('hide');$('app').classList.add('show')},1600)

$('lenSlider').oninput=e=>{S.len=+e.target.value;$('lenVal').textContent=S.len;gen()}

document.querySelectorAll('.sw').forEach(s=>{
  s.onclick=()=>{
    const k=s.dataset.k
    const on=Object.keys(C).filter(k=>S[k]).length
    if(S[k]&&on<=1)return
    S[k]=!S[k]
    s.classList.toggle('on',S[k])
    gen()
  }
})

function pool(){let p='';for(const k in C)if(S[k])p+=C[k];return p}

function gen(){
  const p=pool();if(!p)return
  const r=new Uint32Array(S.len);crypto.getRandomValues(r)
  let pw='';for(let i=0;i<S.len;i++)pw+=p[r[i]%p.length]
  S.cur=pw;render(pw);strength(pw)
}

function render(pw){
  const el=$('pw');el.innerHTML=''
  pw.split('').forEach((c,i)=>{
    const s=document.createElement('span');s.className='c';s.textContent=c
    s.style.animationDelay=i*20+'ms';el.appendChild(s)
  })
}

function strength(pw){
  let s=0
  if(pw.length>=8)s++;if(pw.length>=12)s++;if(pw.length>=20)s++;if(pw.length>=32)s++
  if(/[a-z]/.test(pw))s++;if(/[A-Z]/.test(pw))s++;if(/[0-9]/.test(pw))s++;if(/[^a-zA-Z0-9]/.test(pw))s++
  $('barFill').style.width=Math.min(s/8*100,100)+'%'
}

function toast(){$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1400)}

function copy(){
  if(!S.cur)return
  navigator.clipboard.writeText(S.cur).then(()=>{
    const w=$('pwWrap');w.classList.add('copied');setTimeout(()=>w.classList.remove('copied'),800)
    toast()
  })
}

$('copyBtn').onclick=copy
$('pwWrap').onclick=copy

$('genBtn').onclick=()=>{
  gen()
  if(S.cur&&!S.hist.includes(S.cur)){S.hist.unshift(S.cur);if(S.hist.length>5)S.hist.pop();renderHist()}
}

function renderHist(){
  if(!S.hist.length){$('histSec').style.display='none';return}
  $('histSec').style.display='block'
  const l=$('histList');l.innerHTML=''
  S.hist.forEach(pw=>{
    const d=document.createElement('div');d.className='history-item'
    const t=pw.length>30?pw.slice(0,30)+'…':pw
    d.innerHTML=`<span>${t}</span><span>copy</span>`
    d.onclick=()=>navigator.clipboard.writeText(pw).then(toast)
    l.appendChild(d)
  })
}

gen()
</script>
</body>
</html>
